{
  "name": "hortobots-planning",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build -w @hortobots/shared && npm run build -w @hortobots/api && npm run build -w @hortobots/web",
    "start:render": "npm run start:render -w @hortobots/api",
    "start:local": "npm run start:local -w @hortobots/api",
    "dev": "concurrently \"npm run dev -w @hortobots/api\" \"npm run dev -w @hortobots/web\"",
    "dev:local": "concurrently \"npm run dev:local -w @hortobots/api\" \"npm run dev -w @hortobots/web\""
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "concurrently": "9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.26.0",
    "prettier": "3.4.2",
    "tsx": "^4.19.3",
    "typescript": "5.7.2"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "tinypool": "^2.1.2",
    "@eslint/plugin-kit": "^0.3.4"
  }
}
